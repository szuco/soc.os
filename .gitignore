# --- KiCad ---------------------------------------------------------------
# Automatische Backups
*-backups/
# KiCad 10 legt je Projekt ein eigenes Git-Repo als lokale Historie an
.history/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.bak
_autosave-*
*.lck

# Caches / generierte Zwischenstände
fp-info-cache
*.net
*.xml

# Temporär
~*.*
*.tmp

# Fertigungsdaten werden getaggt released, nicht laufend eingecheckt.
# Ausgabe pro Projekt unter <projekt>/production/ ablegen und gezielt hinzufuegen.
production/

# --- Betriebssystem ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor --------------------------------------------------------------
*.swp
*~

# ESPHome
firmware/esphome/secrets.yaml
.esphome/

# CAD-Zwischenstaende
__pycache__/

# Freerouting-Laufzeitlog (wird beim Routing im CWD angelegt)
logs/

# Bauergebnisse der 3D-Baugruppe: aus den Boards und adapter.py jederzeit neu
# erzeugbar (mechanical/stack.py), zusammen aber ueber 70 MB - das gehoert
# nicht in die Versionsgeschichte.
mechanical/export/stack/*.step
mechanical/export/switchstack_stack.step
