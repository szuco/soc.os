(version 1)

# Befestigungsloecher von Bauteilen sind keine Boardkante.
#
# KiCad behandelt jede NPTH-Bohrung wie eine gefraeste Aussenkontur und
# prueft sie gegen min_copper_edge_clearance = 0,5 mm. Das ist fuer den
# Platinenrand richtig und fuer die Befestigungsloecher eines
# Steckverbinders falsch: Die USB-C-Buchse bringt ihre Loecher mit, der
# Hersteller legt den Abstand zu den eigenen Pads fest, und kein einziges
# vertikales USB-C-Footprint in der KiCad-Bibliothek haelt dabei 0,5 mm ein -
# die Spanne liegt zwischen 0,35 und 0,50 mm.
#
# JLCPCB gibt als Fertigungsgrenze 0,3 mm Bohrung-zu-Kupfer an. Genau darauf
# wird hier gelockert, nicht weiter.
(rule "Befestigungsloecher von Bauteilen"
  (constraint edge_clearance (min 0.3mm))
  (condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'"))

(rule "Bohrungsabstand an Bauteil-Befestigungsloechern"
  (constraint hole_clearance (min 0.2mm))
  (condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'"))

# Der Klinkenstecker ragt absichtlich ueber die Boardkante.
#
# J6 sitzt bei (-9 / +19); sein Massepad reicht bis y = 24,78, die Boardkante
# liegt bei 23,5. Das ist kein Versehen, sondern Voraussetzung dafuer, dass
# die Buchse durch den Abdeckrahmen greift - gen_layouts meldet den Ueberhang
# ausdruecklich als beabsichtigt.
#
# Ohne diese Ausnahme meldet die DRC hier dauerhaft einen Randabstandsfehler
# und verdeckt damit echte Funde. Die Ausnahme gilt NUR fuer dieses eine
# Bauteil, nicht fuer Randabstaende allgemein.
(rule "Klinkenbuchse ragt absichtlich ueber die Kante"
  (constraint edge_clearance (min 0mm))
# Im Fertigungsnutzen tragen die Bauteile ein Praefix (T_ fuer das
# Top-Board), deshalb beide Schreibweisen. Auf dem Mid-Board heisst J6 der
# Haubenkontakt - der darf NICHT ueberstehen, und die .kicad_dru dieses
# Projekts gilt dort auch nicht.
  (condition "A.Reference == 'J6' || B.Reference == 'J6' || A.Reference == 'T_J6' || B.Reference == 'T_J6'"))
